generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql" url = env("DATABASE_URL") }

enum BuildStatus { QUEUED BUILDING SUCCESS FAILED CANCELED }

model User {
 id String @id @default(cuid())
 githubId String @unique
 login String
 email String?
 role String @default("user")
 plan String @default("free")
 buildCredits Int @default(5)
 createdAt DateTime @default(now())
 projects Project[]
 builds Build[]
}

model Project {
 id String @id @default(cuid())
 userId String
 name String
 repoUrl String?
 repoRef String @default("main")
 packageId String @default("com.example.app")
 version String @default("1.0.0")
 user User @relation(fields:[userId],references:[id],onDelete:Cascade)
 builds Build[]
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
}

model Build {
 id String @id
 userId String
 projectId String
 status BuildStatus @default(QUEUED)
 output String @default("apk")
 filename String?
 artifactUrl String?
 error String?
 createdAt DateTime @default(now())
 startedAt DateTime?
 finishedAt DateTime?
 user User @relation(fields:[userId],references:[id],onDelete:Cascade)
 project Project @relation(fields:[projectId],references:[id],onDelete:Cascade)
}

model Setting {
 id String @id @default(cuid())
 key String @unique
 value String
 updatedAt DateTime @updatedAt
}